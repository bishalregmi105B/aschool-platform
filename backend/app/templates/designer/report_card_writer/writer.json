{
  "type": "writer",
  "config": {
    "size": "A4",
    "orientation": "portrait",
    "font": "Arial",
    "fontSize": 11
  },
  "blocks": [
    {
      "type": "header_band",
      "school": "YOUR SCHOOL NAME",
      "subtitle": "School Address | Phone | www.school.edu",
      "tagline": "ACADEMIC PROGRESS REPORT",
      "bg": "#1e40af",
      "color": "#ffffff"
