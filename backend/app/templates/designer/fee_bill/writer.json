{
  "type": "writer",
  "config": {
    "size": "A4",
    "orientation": "portrait",
    "font": "Arial",
    "fontSize": 11
  },
  "blocks": [
    {
      "type": "header_band",
      "school": "{school_name}",
      "subtitle": "{school_address}",
      "tagline": "FEE BILL / RECEIPT",
      "bg": "#065f46",
      "color": "#ffffff"
    },
    {
      "type": "spacer",
      "height": 6
    },
    {
      "type": "columns",
      "columns": [
        {
          "text": "Bill No: {bill_no}",
          "align": "left"
        },
        {
          "text": "Date: {bill_date}",
          "align": "right"
        }
      ]
    },
    {
      "type": "divider",
      "color": "#065f46",
      "width": 1
    },
    {
      "type": "spacer",
      "height": 4
    },
    {
      "type": "columns",
      "columns": [
        {
          "text": "Student: **{student_name}**",
          "align": "left"
        },
        {
          "text": "Class: {class_name}  Section: {section_name}",
          "align": "right"
        }
      ]
    },
    {
      "type": "columns",
      "columns": [
        {
          "text": "Roll No: {roll_no}",
          "align": "left"
        },
        {
          "text": "Due Date: {due_date}",
          "align": "right"
        }
      ]
    },
    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "fee_rows"
    },
    {
      "type": "spacer",
      "height": 8
    },
    {
      "type": "paragraph",
      "text": "Remarks: {remarks}",
      "align": "left",
      "color": "#64748b",
      "bold": false,
      "italic": false,
      "fontSize": 12
    },
    {
      "type": "spacer",
      "height": 32
    },
    {
      "type": "signature",
      "labels": [
        "Accountant",
        "Principal"
      ]
    }
  ]
}