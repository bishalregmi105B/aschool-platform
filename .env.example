# ═══════════════════════════════════════════════════════════
# ASchool Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Frontend API endpoints (used by browser calls)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Internal API URL for Next.js server-side calls (SSR/middleware)
API_URL=http://localhost:5000

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://aschool:aschool@localhost:5432/aschool
POSTGRES_USER=aschool
POSTGRES_PASSWORD=aschool
POSTGRES_DB=aschool

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ── AI (Anthropic Claude + Groq) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_FAST=claude-haiku-4-5-20250514
AI_MODEL_QUALITY=claude-sonnet-4-20250514
AI_MAX_RETRIES=3
AI_TIMEOUT_FAST=30
AI_TIMEOUT_QUALITY=60
# Groq (optional — faster/cheaper; used by AITokenHub if set)
GROQ_API_KEY=gsk_...
# AI Token Hub quota defaults
AI_DEFAULT_DAILY_LIMIT=10000
AI_DEFAULT_MONTHLY_LIMIT=100000
AI_QUOTA_ENFORCEMENT=true

# ── SMS (Sparrow SMS — Nepal) ────────────────────────────
SPARROW_SMS_TOKEN=your-sparrow-token
SPARROW_SMS_FROM=ASchool

# ── WhatsApp (Meta Cloud API) ────────────────────────────
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_ACCESS_TOKEN=your-wa-token
WA_VERIFY_TOKEN=your-webhook-verify-token
WA_APP_SECRET=your-app-secret

# ── Payments (Nepal) ────────────────────────────────────
ESEWA_MERCHANT_ID=your-esewa-id
ESEWA_SECRET_KEY=your-esewa-secret
ESEWA_ENVIRONMENT=development

KHALTI_SECRET_KEY=your-khalti-secret
KHALTI_PUBLIC_KEY=your-khalti-public
KHALTI_ENVIRONMENT=development

FONEPAY_MERCHANT_ID=your-fonepay-id
FONEPAY_SECRET_KEY=your-fonepay-secret

# ── File Storage (Cloudflare R2) ─────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=aschool
R2_PUBLIC_URL=https://files.aschool.com.np

# ── Email ────────────────────────────────────────────────
MAIL_SERVER=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your-mail-user
MAIL_PASSWORD=your-mail-password
MAIL_DEFAULT_SENDER=noreply@aschool.com.np

# ── Social (Meta Graph API) ─────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# ── Firebase (GPS Bus Tracking) ──────────────────────────
# WhatsApp Cloud API (optional; leave empty to skip WhatsApp sends)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FIREBASE_DATABASE_URL=https://aschool-gps.firebaseio.com
FIREBASE_SECRET=your-firebase-secret

# ── Monitoring ───────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn

# ── Domain ───────────────────────────────────────────────
BASE_DOMAIN=aschool.com.np

# ── AI provider defaults (token hub quota) ──────────────────────────
AI_DEFAULT_DAILY_LIMIT=10000
AI_DEFAULT_MONTHLY_LIMIT=100000
AI_QUOTA_ENFORCEMENT=true
GROQ_API_KEY=
GROQ_MODEL_FAST=
GROQ_MODEL_QUALITY=
CLAUDE_QUALITY_MODEL=

# ── Payments ────────────────────────────────────────────────────────
FONEPAY_ENVIRONMENT=test

# ── Background jobs / infra ─────────────────────────────────────────
CELERY_TIMEZONE=Asia/Kathmandu

# ── Firebase (GPS tracking + push) ─────────────────────────────────
FIREBASE_SERVER_KEY=

# ── Upload virus scanning (optional ClamAV) ────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_STRICT=false
MAX_FILE_SIZE_MB=25

# ── Database backups ───────────────────────────────────────────────
DB_BACKUP_DEST=
LAST_DB_BACKUP_AT=

# ── Next.js server-side ────────────────────────────────────────────
API_URL=http://flask:5000
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_WS_URL=http://localhost:5001
ISR_REVALIDATE_SECRET=
SENTRY_DSN=

# ── Cookie session domain (.aschool.com.np for cross-subdomain SSO) ─
COOKIE_DOMAIN=.aschool.com.np
COOKIE_SECURE=auto
